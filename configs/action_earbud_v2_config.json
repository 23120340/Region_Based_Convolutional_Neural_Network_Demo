{
  "schema_version": 1,
  "spatial": {
    "backbone": "facebook/dinov2-small",
    "embedding_dim": 384,
    "sample_fps": 10.0,
    "freeze": true
  },
  "temporal": {
    "sequence_length": 16,
    "window_stride": 4,
    "hidden_dim": 256,
    "num_layers": 2,
    "bidirectional": true,
    "head_dim": 128,
    "dropout": 0.3
  },
  "training": {
    "batch_size": 16,
    "epochs": 30,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "seed": 42
  },
  "actions": [
    "idle",
    "open_case",
    "insert_first_earbud",
    "insert_second_earbud",
    "close_case",
    "remove_earbud"
  ]
}
