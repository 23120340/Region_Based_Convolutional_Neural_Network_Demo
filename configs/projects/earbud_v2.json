{
  "schema_version": 1,
  "name": "earbud_v2",
  "display_name": "Earbud Assembly Monitor v2",
  "camera_config": "configs/camera_earbud_config.json",
  "fsm_config": "configs/earbud_v2_fsm_config.json",
  "action_config": "configs/action_earbud_pilot_config.json",
  "action_model": "artifacts/action_model_pilot/best.pt",
  "event_log": "artifacts/events/earbud_v2.jsonl",
  "fusion": {
    "factory": "assembly.slot_fusion:PairedEarbudFusionEngine",
    "parameters": {
      "required_earbuds": 2,
      "stable_frames": 3,
      "min_action_confidence": 0.5,
      "min_detection_confidence": 0.35,
      "containment_threshold": 0.6,
      "slot_overlap_threshold": 0.4,
      "require_closed_case": true,
      "case_action": "open_case",
      "require_case_action": true,
      "earbud_slot_pairs": {
        "left_earbud": "empty_left",
        "right_earbud": "empty_right"
      }
    }
  }
}
